# ============================================================================
# Autodistil-KG Graph RAG Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control!

# ============================================================================
# Neo4j Graph Database Configuration
# ============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ============================================================================
# OpenAI Configuration (LLM + Embeddings)
# ============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================================
# Graph RAG Settings
# ============================================================================
GRAPHRAG_LLM_MODEL=gpt-4
GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small
GRAPHRAG_EMBEDDING_DIMENSIONS=1536

# Comma-separated list of enabled retrievers: vector, cypher, synonym
GRAPHRAG_RETRIEVERS=vector,cypher,synonym

# Number of top results to retrieve
GRAPHRAG_SIMILARITY_TOP_K=5
