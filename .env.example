# ============================================================================
# Autodistil-KG — Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The .env file is read by both docker compose (for container env vars) and
# by the core pipeline when running locally.
#
# NEVER commit .env to version control.
# ============================================================================

# ── Neo4j ──────────────────────────────────────────────────────────────────
# Password for the Neo4j database.
# The compose neo4j service starts with NEO4J_AUTH=neo4j/<NEO4J_PASSWORD>.
# The api service overrides NEO4J_URI to use the container service name.
# For local (non-Docker) runs, set NEO4J_URI below.
NEO4J_PASSWORD=password
NEO4J_URI=bolt://localhost:7687     # overridden to bolt://neo4j:7687 inside Docker
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# ── LLM Provider ───────────────────────────────────────────────────────────
# Set credentials for ONE provider. Leave the others blank.
# The pipeline picks whichever keys are present.

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=                    # leave blank for official api.openai.com

# Anthropic Claude
CLAUDE_API_KEY=                     # sk-ant-...
CLAUDE_MODEL=                       # e.g. claude-3-opus-20240229

# Google Gemini (Vertex AI)
GEMINI_PROJECT_ID=
GEMINI_LOCATION=us-central1
GEMINI_MODEL=                       # e.g. gemini-pro
GEMINI_CREDENTIALS_PATH=            # path to service-account JSON (inside container)

# Ollama (local model server on the host machine)
OLLAMA_BASE_URL=                    # e.g. http://host.docker.internal:11434
OLLAMA_MODEL=                       # e.g. llama3

# vLLM (self-hosted inference server)
VLLM_BASE_URL=
VLLM_MODEL=

# ── Redis ───────────────────────────────────────────────────────────────────
# These defaults match the compose redis service.
# The api service overrides REDIS_HOST to the service name inside Docker.
REDIS_HOST=localhost                 # overridden to "redis" inside Docker
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=                     # leave blank if no auth
REDIS_KEY_PREFIX=graph_traverser:

# ── Pipeline Defaults (optional) ────────────────────────────────────────────
# These can also be set per-run via the UI or API config payload.
# TRAVERSAL_STRATEGY=bfs            # bfs | dfs | random | semantic
# TRAVERSAL_MAX_NODES=100
# TRAVERSAL_MAX_DEPTH=3
# DATASET_OUTPUT_PATH=output/dataset.jsonl
# LOG_LEVEL=INFO
